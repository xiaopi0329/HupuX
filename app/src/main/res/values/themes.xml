<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      NoActionBar：模块页自带标题，用 ActionBar 会让「HupuX」出现两遍。
      windowBackground 跟随日/夜色，避免打开时闪白。
    -->
    <style name="Theme.HupuX" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
